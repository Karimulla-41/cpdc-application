# ==============================================================================
# CPDC PRODUCTION APPLICATION — ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. DATABASE PERSISTENCE (PostgreSQL / SQLite)
# For local zero-dependency testing, "file:./dev.db" is used.
# For production PostgreSQL deployment, specify your hosted PostgreSQL connection string:
# DATABASE_URL="postgresql://username:password@localhost:5432/cpdc_db?schema=public"
DATABASE_URL="file:./dev.db"

# 2. NEXTAUTH SESSION PERSISTENCE & SECURITY
# Canonical URL of your application (Required by NextAuth)
# Development: http://localhost:3000
# Production:  https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# Secret key for encrypting NextAuth JWT session tokens (Generate using `openssl rand -base64 32`)
NEXTAUTH_SECRET="cpdc_secret_production_key_2026_change_in_prod"

# 3. GOOGLE OAUTH 2.0 / OIDC CREDENTIALS (REQUIRED FOR PRODUCTION LOGINS)
# Instructions to obtain real Google OAuth Credentials:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Select / Create a project for CPDC.
# 3. Navigate to APIs & Services > Credentials.
# 4. Click "Create Credentials" -> Select "OAuth client ID".
# 5. Set Application Type to "Web application".
# 6. Add Authorized JavaScript Origins:
#    - Development: http://localhost:3000
#    - Production:  https://your-domain.com
# 7. Add Authorized Redirect URIs:
#    - Development: http://localhost:3000/api/auth/callback/google
#    - Production:  https://your-domain.com/api/auth/callback/google
# 8. Copy Client ID and Client Secret below:
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-YOUR_GOOGLE_CLIENT_SECRET"

# 4. SMTP TRANSACTIONAL EMAIL DISPATCH (FOR OD LIST RECOMMENDATIONS)
# If SMTP variables are omitted, OD List emails will safely output preview logs in server console.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="cpdc.official@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="CPDC Official <cpdc.official@gmail.com>"
